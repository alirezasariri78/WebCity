{
  "name": "webcity",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Build a city, get a website. A city-building game that turns what you build into a real website.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "build:edge": "npm run build && node scripts/edge-bundle.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.10.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^6.3.5",
    "vitest": "^3.2.7"
  }
}
